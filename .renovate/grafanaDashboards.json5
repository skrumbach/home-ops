{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Not replaced by home-operations/renovate-presets//apps/grafanaDashboards.json5: its managers read only files named
  // grafanadashboard.yaml (grafana-operator CRs); every board here is a gnetId or url: in the grafana chart's helmrelease.yaml.
  customDatasources: {
    "grafana-dashboards": {
      defaultRegistryUrlTemplate: "https://grafana.com/api/dashboards/{{packageName}}",
      format: "json",
      transformTemplates: ['{"releases":[{"version": $string(revision)}]}'],
    },
  },
  customManagers: [
    {
      description: "Process Grafana dashboards",
      customType: "regex",
      managerFilePatterns: ["/(^|/)kubernetes/.+\\.ya?ml$/"],
      matchStrings: [
        'depName="(?<depName>.*)"\\n(?<indentation>\\s+)gnetId: (?<packageName>\\d+)\\n.+revision: (?<currentValue>\\d+)'
      ],
      autoReplaceStringTemplate: 'depName="{{{depName}}}"\n{{{indentation}}}gnetId: {{{packageName}}}\n{{{indentation}}}revision: {{{newValue}}}',
      datasourceTemplate: "custom.grafana-dashboards",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
    {
      // A url: dashboard on a branch changes the board on every Grafana restart, unreviewed. Pin the commit; git-refs proposes main's HEAD.
      description: "Grafana url: dashboards pinned to a GitHub commit",
      customType: "regex",
      managerFilePatterns: ["/(^|/)kubernetes/apps/base/monitoring/grafana/app/helmrelease\\.yaml$/"],
      matchStrings: [
        "url: https://raw\\.githubusercontent\\.com/(?<depName>[\\w.-]+/[\\w.-]+)/(?<currentDigest>[0-9a-f]{40})/\\S+\\.json",
      ],
      packageNameTemplate: "https://github.com/{{{depName}}}",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs",
    },
    {
      // Same depName as the flux OCIRepository dep (one branch). The packageName copies the preset's mirror.gcr.io -> docker.io registryAlias, which
      // regex managers ignore: on mirror.gcr.io (no timestamps) the boards skipped the 3-day release age the chart waits out on Docker Hub, and the branch dropped the chart (#2475).
      description: "Envoy Gateway dashboards pinned to the deployed gateway-helm chart tag",
      customType: "regex",
      managerFilePatterns: ["/(^|/)kubernetes/apps/base/monitoring/grafana/app/helmrelease\\.yaml$/"],
      matchStrings: [
        "url: https://raw\\.githubusercontent\\.com/envoyproxy/gateway/(?<currentValue>v\\d+\\.\\d+\\.\\d+)/\\S+\\.json",
      ],
      depNameTemplate: "mirror.gcr.io/envoyproxy/gateway-helm",
      packageNameTemplate: "docker.io/envoyproxy/gateway-helm",
      datasourceTemplate: "docker",
    },
  ],
  packageRules: [
    {
      // Docker Hub tags every chart twice (1.10.0, v1.10.0) and docker versioning ranks them equal, so the chart could take 1.10.0 while the
      // board URLs need GitHub's v1.10.0. Only v-tags are versions here, for the chart and the boards alike.
      description: "gateway-helm chart and Envoy Gateway dashboards move to the same v-prefixed tag",
      matchDatasources: ["docker"],
      matchDepNames: ["mirror.gcr.io/envoyproxy/gateway-helm"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      addLabels: ["renovate/grafana-dashboard"],
      automerge: true,
      commitMessageExtra: "({{currentVersion}} → {{newVersion}})",
      commitMessageTopic: "dashboard {{depName}}",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore",
    },
    {
      // toolhive's main moves daily; one grouped PR a month (America/New_York, .renovaterc.json5) instead of a digest PR per commit.
      description: "Commit-pinned Grafana url: dashboards - one grouped PR a month",
      matchDatasources: ["git-refs"],
      matchFileNames: ["kubernetes/apps/base/monitoring/grafana/**"],
      groupName: "Grafana url dashboards",
      groupSlug: "grafana-url-dashboards",
      schedule: ["on the first day of the month"],
      addLabels: ["renovate/grafana-dashboard"],
      // No automerge: the point of the pin is that a board change is reviewed (compare link in the PR).
      automerge: false,
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      semanticCommitScope: "grafana-dashboards",
      semanticCommitType: "chore",
    },
  ],
}
