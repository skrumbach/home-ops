{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The talos-factory datasource and the factory.talos.dev installer manager (depName siderolabs/talos) come from
  // github>home-operations/renovate-presets//apps/talosFactory.json5 (.renovaterc.json5). This file keeps what it does not cover.
  customManagers: [
    {
      description: "Annotated container images in Talos machine config templates",
      customType: "regex",
      managerFilePatterns: ["/(^|/)talos/.+\\.ya?ml(?:\\.j2)?$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*image:\\s*\\S+:(?<currentValue>[^\\s@]+)",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}docker{{/if}}",
    },
  ],
  packageRules: [
    {
      // The base preset points the kubernetes manager at every *.yaml(.j2); the regex managers own talos/, so a second extraction would only duplicate them.
      // Wider than the upstream preset's rule, which disables only factory.talos.dev refs: this also covers the kubelet and control-plane images.
      description: "Talos templates are owned by the regex managers, not the kubernetes manager",
      matchManagers: ["kubernetes"],
      matchFileNames: ["talos/**"],
      enabled: false,
    },
  ],
}
