{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // Supply-chain pin: a tag can be re-pushed, a digest cannot. 16 of 53 apps were pinned by hand; peer repos pin 7-9 of 10.
      // helm-values and kubernetes managers only: the annotated-dependency regex has no currentDigest capture (it would rewrite tuppr's version: field),
      // and flux chart refs are OCIRepository tags. kubernetes/** only, so Talos, mise and CI images are untouched.
      // rsshub and browserless/chrome float on latest with their own digest rule. quay.io/ceph/ceph: a CephCluster image change restarts every Ceph daemon, pin it with an attended Ceph bump.
      // Verified 2026-11-07: operator CRs (LiteLLMProxy, MCPServer, EMQX, Dragonfly, Envoy) accept digests, pin PR #2411.
      // Adding a digest changes the pod spec, so each newly pinned workload rolls once.
      description: "Pin container image digests in kubernetes/**",
      matchDatasources: ["docker"],
      matchManagers: ["helm-values", "kubernetes"],
      matchFileNames: ["kubernetes/**"],
      matchPackageNames: ["!ghcr.io/diygod/rsshub", "!docker.io/browserless/chrome", "!quay.io/ceph/ceph"],
      pinDigests: true,
    },
    {
      // MUST stay after groups.json5 (later preset, last match wins): the Talos, Tdarr and Dragonfly group rules would otherwise split pins into their own branches.
      description: "Keep every digest pin in the one Pin Dependencies PR",
      matchUpdateTypes: ["pinDigest"],
      groupName: "Pin Dependencies",
      groupSlug: "pin-dependencies",
      group: {
        commitMessageTopic: "dependencies",
        commitMessageExtra: "",
      },
    },
    {
      description: "LiteLLM plain vX.Y.Z tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/berriai/litellm-non_root"],
      versioning: "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    {
      description: "Override Helmfile Dependency Name",
      matchDatasources: ["docker"],
      matchManagers: ["helmfile"],
      overrideDepName: "{{packageName}}",
    },
    {
      // No GitHub repo. Resolve via docker 1password/op with semver, or a -beta tag ranks as stable.
      description: "1Password CLI has no GitHub repo; resolve via the official docker image",
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      overrideDatasource: "docker",
      overridePackageName: "1password/op",
      versioning: "semver",
    },
    {
      // 2.3.x calls an Enterprise-only API and sticks the OSS broker (emqx/emqx-operator#1202).
      description: "Pin EMQX operator to 2.2.x (Open-Source broker compat)",
      matchPackageNames: ["emqx-operator", "ghcr.io/emqx/emqx-operator"],
      allowedVersions: "<2.3.0",
    },
    {
      // A major bump needs a new archive serverName and matching extension images in the same change.
      description: "Keep CloudNativePG Postgres operand images on major 18",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
      allowedVersions: "/^18\\./",
    },
    {
      // EMQX Open-Source ended at 5.8.x; 5.9/5.10/6.x are Enterprise-only.
      description: "Keep EMQX broker on Open-Source 5.8.x",
      matchDatasources: ["docker"],
      matchPackageNames: ["public.ecr.aws/emqx/emqx"],
      allowedVersions: "<5.9.0",
    },
    {
      // Paperless-ngx 3.4.2's gotenberg-client 1.0.0 still calls /forms/pdfengines/* and the pdfa field that
      // Gotenberg 9 removed (paperless-ngx/paperless-ngx#14702); upstream compose pins 8.38. Lift with Paperless.
      description: "Hold Gotenberg on major 8 until Paperless-ngx supports 9",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/gotenberg/gotenberg"],
      allowedVersions: "<9.0.0",
    },
    {
      // Tika 4 removed /tika/form/* and renamed the metadata keys; Paperless-ngx's tika-client does not support it
      // (paperless-ngx/paperless-ngx#13755); upstream compose pins 3.3.1.0. A regex, because 3.x tags have four
      // parts and 4.x three, which the default docker versioning cannot order. Lift with Paperless.
      description: "Hold Apache Tika on major 3 until Paperless-ngx supports 4",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/apache/tika"],
      allowedVersions: "/^3\\./",
    },
    {
      // 2.x is untested against the ToolHive vmcp gateway; lift this after a test.
      description: "Keep github-mcp-server on major 1",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/github/github-mcp-server"],
      allowedVersions: "<2",
    },
    {
      // Provider is generated from the server OpenAPI schema. Bump it with the server tag. automerge stays false.
      description: "Keep the Authentik OpenTofu provider aligned with the server release line",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["goauthentik/authentik"],
      automerge: false,
    },
    {
      // x.0.z is dev, x.1.z is RC; registry tags surface RCs as upgrades (#1396). Not for ghcr.io/rook/ceph.
      description: "Keep quay.io/ceph/ceph on stable x.2.z tags (skip x.0.z dev and x.1.z RC)",
      matchDatasources: ["docker"],
      matchPackageNames: ["quay.io/ceph/ceph"],
      allowedVersions: "/^v?\\d+\\.2\\.\\d+$/",
    },
    {
      // Docker compatibility treats the per-release hash as a qualifier, so leave it uncaptured. Do not name the group compatibility.
      description: "Plex uses X.Y.Z.BUILD-HASH tags; regex-version them so Renovate can see updates past the per-release commit hash",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/plexinc/pms-docker"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-[a-f0-9]+$",
    },
    {
      // searxng tags are CalVer plus a git SHA (2025.5.17-86373e7). Without this, Renovate's docker versioning cannot order them. Major is the year, so a year rollover is a major update and never automerges (autoMerge.json5 has no major rule).
      description: "SearXNG uses CalVer YYYY.M.D-<sha> tags; regex-version them so Renovate can order them",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/searxng/searxng"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-[0-9a-f]+$",
    },
    {
      // Off-range node makes `npx renovate` resolve an old release and fail the config check (#2231). Raise with Renovate's engines.node.
      description: "Keep workflow setup-node on the major Renovate's engines.node allows",
      matchManagers: ["github-actions"],
      matchDepNames: ["node"],
      allowedVersions: "<25",
    },
  ],
}
