    {
      "id": 8,
      "type": "stat",
      "title": "Old backups",
      "description": "kopiur policies whose last successful backup is older than their alert allows: 6h for a -ceph policy (4h schedule), 48h for an -r2 policy (daily).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "((count(time() - kopiur_policy_last_backup_success_timestamp_seconds{policy=~\".+-ceph$\"} > 21600) or vector(0)) + (count(time() - kopiur_policy_last_backup_success_timestamp_seconds{policy=~\".+-r2$\"} > 172800) or vector(0))) and on() count(kopiur_policy_last_backup_success_timestamp_seconds)",
          "legendFormat": "",
          "range": false,
